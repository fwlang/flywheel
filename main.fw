import desktop
import html.*

int value1 = int input("Enter value 1: ")
int value2 = int input("Enter value 2: ")
element styling = <style>
body {
    background-color: #0a0909;
    color: #ffffff;
}
</style>

return <html>{styling}<body>
    <h1>Hello, World!</h1>
    <p>Value 1: {value1}</p>
    <p>Value 2: {value2}</p>
    <p>Sum: {value1 + value2}</p>
    <img src="image.png" alt="Image" style="max-width: 50px; height: auto;">
    <p>test</p>
</body></html>