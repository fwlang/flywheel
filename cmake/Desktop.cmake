# Native webview support is optional; the core runtime always supports the value/API.
set(FLYWHEEL_DESKTOP "AUTO" CACHE STRING "Build desktop backend: AUTO, ON, or OFF")
set_property(CACHE FLYWHEEL_DESKTOP PROPERTY STRINGS AUTO ON OFF)
string(TOUPPER "${FLYWHEEL_DESKTOP}" _fw_desktop_mode)
if(NOT _fw_desktop_mode MATCHES "^(AUTO|ON|OFF)$")
  message(FATAL_ERROR "FLYWHEEL_DESKTOP must be AUTO, ON, or OFF")
endif()
set(_fw_desktop_available TRUE)
if(UNIX AND NOT APPLE AND NOT _fw_desktop_mode STREQUAL "OFF")
  find_package(PkgConfig QUIET)
  if(PkgConfig_FOUND)
    pkg_search_module(FW_WEBKIT QUIET webkit2gtk-4.1 webkitgtk-6.0 webkit2gtk-4.0)
  endif()
  if(NOT FW_WEBKIT_FOUND)
    set(_fw_desktop_available FALSE)
  endif()
endif()
if(_fw_desktop_mode STREQUAL "ON" AND NOT _fw_desktop_available)
  message(FATAL_ERROR "Desktop requires GTK and WebKitGTK development packages (e.g. libgtk-3-dev libwebkit2gtk-4.1-dev)")
endif()
if(NOT _fw_desktop_mode STREQUAL "OFF" AND _fw_desktop_available)
  include(FetchContent)
  set(WEBVIEW_BUILD_SHARED_LIBRARY OFF)
  set(WEBVIEW_BUILD_STATIC_LIBRARY OFF)
  set(WEBVIEW_BUILD_TESTS OFF)
  set(WEBVIEW_BUILD_EXAMPLES OFF)
  set(WEBVIEW_BUILD_DOCS OFF)
  set(WEBVIEW_INSTALL_TARGETS OFF)
  FetchContent_Declare(webview
    URL https://codeload.github.com/webview/webview/tar.gz/refs/tags/0.12.0
    URL_HASH SHA256=e2c8d0bed3fcd13e624074448b7d3b1d0b0d03546a15839f17ee0013f2cba1db
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(webview)
  add_library(flywheel_desktop SHARED ${PROJECT_SOURCE_DIR}/runtime/desktop_backend.cpp)
  target_link_libraries(flywheel_desktop PRIVATE webview::core)
  set_target_properties(flywheel_desktop PROPERTIES
    CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES
    MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
  add_dependencies(flywheel flywheel_desktop)
  foreach(_fw_target flywheel flywheel_runtime)
    target_compile_definitions(${_fw_target} PRIVATE FW_DESKTOP_BACKEND="$<TARGET_FILE:flywheel_desktop>")
  endforeach()
  install(TARGETS flywheel_desktop LIBRARY DESTINATION lib RUNTIME DESTINATION lib)
  install(FILES "${webview_SOURCE_DIR}/LICENSE" DESTINATION share/licenses/flywheel RENAME webview-LICENSE)
  message(STATUS "Flywheel desktop backend: enabled (webview 0.12.0)")
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_program(FW_XVFB_RUN xvfb-run)
    find_program(FW_XDOTOOL xdotool)
    find_program(FW_DBUS_RUN_SESSION dbus-run-session)
    if(FW_XVFB_RUN AND FW_XDOTOOL AND FW_DBUS_RUN_SESSION)
      add_test(NAME desktop_webview
        COMMAND ${FW_DBUS_RUN_SESSION} -- ${FW_XVFB_RUN} -a
          ${Python3_EXECUTABLE} ${PROJECT_SOURCE_DIR}/tests/desktop.py $<TARGET_FILE:flywheel>)
      set_tests_properties(desktop_webview PROPERTIES TIMEOUT 100)
    endif()
  endif()
else()
  foreach(_fw_target flywheel flywheel_runtime)
    target_compile_definitions(${_fw_target} PRIVATE FW_DESKTOP_BACKEND="")
  endforeach()
  message(STATUS "Flywheel desktop backend: disabled; window.run() will raise DesktopError")
endif()
