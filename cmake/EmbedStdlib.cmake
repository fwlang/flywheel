# Writes OUTPUT, a C++ source that embeds each Flywheel-source library module in stdlib/fw as a
# byte array (MSVC limits string literal length), keyed by module name.
file(GLOB modules "${SOURCE_DIR}/*.fw")
list(SORT modules)
set(content "// Generated by cmake/EmbedStdlib.cmake from stdlib/fw; do not edit.\n#include <map>\n#include <string>\nnamespace fw {\n")
set(entries "")
set(index 0)
foreach(module IN LISTS modules)
  get_filename_component(name "${module}" NAME_WE)
  file(READ "${module}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f])" "\\1\n" bytes "${bytes}")
  string(APPEND content "static const unsigned char module${index}[] = {\n${bytes}0};\n")
  string(APPEND entries "        {\"${name}\", std::string(reinterpret_cast<const char *>(module${index}), sizeof(module${index}) - 1)},\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND content "const std::map<std::string, std::string> &libraryModules() {\n    static const std::map<std::string, std::string> modules = {\n${entries}    };\n    return modules;\n}\n} // namespace fw\n")
file(WRITE "${OUTPUT}.tmp" "${content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
